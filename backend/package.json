{
  "name": "thole-d1-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply thole-d1 --local",
    "migrate:remote": "wrangler d1 migrations apply thole-d1 --remote",
    "typecheck": "tsc --noEmit",
    "db:seed": "wrangler d1 execute thole-d1 --local --file=migrations/0001_schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.80.0"
  }
}